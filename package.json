{
  "name": "@physmark/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @physmark/web dev",
    "dev:desktop": "pnpm --filter @physmark/desktop dev",
    "build": "pnpm -r --filter='./packages/*' build",
    "build:web": "pnpm build && pnpm --filter @physmark/web build",
    "build:desktop": "pnpm build && pnpm --filter @physmark/desktop tauri build",
    "build:vscode": "pnpm build && pnpm --filter physmark-vscode build"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.10"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0"
  }
}
